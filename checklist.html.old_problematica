<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checklist - Sunset Bar</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
        }

        .header {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            text-align: center;
        }

        .header h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }

        .postazione-badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .turno-info {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin-top: 15px;
        }

        .turno-info p {
            color: #666;
            font-size: 14px;
            margin: 5px 0;
        }

        .turno-info strong {
            color: #333;
        }

        .dipendente-select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 16px;
            margin-top: 10px;
            background: white;
        }

        .category-section {
            background: white;
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .category-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f0f0f0;
        }

        .category-badge {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 10px;
        }

        .category-name {
            font-size: 18px;
            font-weight: 700;
            color: #333;
        }

        .task-item {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .task-item:hover {
            background: #e9ecef;
            transform: translateY(-2px);
        }

        .task-item.completed {
            background: #d4edda;
            border-color: #28a745;
        }

        .checkbox-wrapper {
            margin-right: 15px;
        }

        .checkbox-wrapper input[type="checkbox"] {
            width: 30px;
            height: 30px;
            cursor: pointer;
            accent-color: #28a745;
        }

        .task-content {
            flex: 1;
        }

        .task-name {
            font-size: 16px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
        }

        .task-info {
            font-size: 12px;
            color: #666;
        }

        .completed-by {
            font-size: 12px;
            color: #28a745;
            font-weight: 600;
            margin-top: 8px;
            display: flex;
            align-items: center;
        }

        .completed-by::before {
            content: "✓";
            margin-right: 5px;
            font-size: 16px;
        }

        .no-tasks {
            text-align: center;
            padding: 40px;
            color: #999;
        }

        .refresh-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 50%;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 5px 20px rgba(40, 167, 69, 0.4);
            transition: all 0.3s ease;
        }

        .refresh-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 8px 30px rgba(40, 167, 69, 0.6);
        }

        .refresh-btn:active {
            transform: scale(0.95);
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: white;
            font-size: 18px;
        }

        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 10px;
            margin: 20px;
            text-align: center;
        }

        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .header {
                padding: 20px;
            }

            .header h1 {
                font-size: 24px;
            }

            .category-section {
                padding: 15px;
            }

            .task-item {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📋 Checklist Giornaliera</h1>
            <div class="postazione-badge" id="postazioneBadge">CARICAMENTO...</div>
            
            <div class="turno-info" id="turnoInfo">
                <p><strong>Caricamento informazioni turno...</strong></p>
            </div>

            <select class="dipendente-select" id="dipendenteSelect">
                <option value="">Caricamento...</option>
            </select>
        </div>

        <div id="tasksContainer">
            <div class="loading">⏳ Caricamento task...</div>
        </div>
    </div>

    <button class="refresh-btn" onclick="loadTasks()" title="Ricarica">🔄</button>

    <script>
        const API_BASE = window.location.origin + '/api';
        let currentPostazione = 'banco';
        let currentTurno = null;
        let currentDipendente = '';

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('postazione')) {
            currentPostazione = urlParams.get('postazione');
        }

        async function init() {
            document.getElementById('postazioneBadge').textContent = currentPostazione.toUpperCase();
            await loadCurrentTurno();
            await loadTasks();
            setInterval(loadTasks, 120000);
        }

        async function loadCurrentTurno() {
            try {
                const res = await fetch(`${API_BASE}/turni/adesso`);
                const turni = await res.json();
                
                const turnoInfo = document.getElementById('turnoInfo');
                const dipendenteSelect = document.getElementById('dipendenteSelect');
                
                if (turni.length === 0) {
                    turnoInfo.innerHTML = '<p><strong>⚠️ Nessun turno attivo</strong></p><p>Inserisci manualmente il tuo nome</p>';
                    dipendenteSelect.innerHTML = '<option value="">Seleziona o scrivi il tuo nome</option>';
                    return;
                }

                let turnoFiltrato = turni;
                if (currentPostazione === 'banco') {
                    turnoFiltrato = turni.filter(t => !t.bar || t.bar.toLowerCase().includes('banco') || t.bar.toLowerCase().includes('sunset'));
                } else if (currentPostazione === 'cucina') {
                    turnoFiltrato = turni.filter(t => t.bar && t.bar.toLowerCase().includes('cucina'));
                }

                if (turnoFiltrato.length === 0) {
                    turnoFiltrato = turni;
                }

                currentTurno = turnoFiltrato[0];
                
                const nomi = turnoFiltrato.map(t => t.nome).join(', ');
                turnoInfo.innerHTML = `
                    <p><strong>👥 In turno ora:</strong> ${nomi}</p>
                    <p><strong>🕐 Orario:</strong> ${currentTurno.orario_inizio} - ${currentTurno.orario_fine}</p>
                    <p><strong>📍 Bar:</strong> ${currentTurno.bar}</p>
                `;

                dipendenteSelect.innerHTML = turnoFiltrato.map((t, i) => 
                    `<option value="${t.nome}" ${i === 0 ? 'selected' : ''}>${t.nome}</option>`
                ).join('');
                dipendenteSelect.innerHTML += '<option value="altro">Altro dipendente...</option>';

                currentDipendente = turnoFiltrato[0].nome;
                
                dipendenteSelect.addEventListener('change', (e) => {
                    if (e.target.value === 'altro') {
                        const nome = prompt('Inserisci il tuo nome:');
                        if (nome) {
                            currentDipendente = nome;
                            const opt = document.createElement('option');
                            opt.value = nome;
                            opt.textContent = nome;
                            opt.selected = true;
                            dipendenteSelect.insertBefore(opt, dipendenteSelect.lastElementChild);
                        } else {
                            dipendenteSelect.selectedIndex = 0;
                        }
                    } else {
                        currentDipendente = e.target.value;
                    }
                });

            } catch (error) {
                console.error('Errore caricamento turno:', error);
                document.getElementById('turnoInfo').innerHTML = '<p>⚠️ Errore caricamento turno</p>';
            }
        }

        async function loadTasks() {
            try {
                const res = await fetch(`${API_BASE}/tasks/postazione/${currentPostazione}`);
                const tasks = await res.json();

                const container = document.getElementById('tasksContainer');
                
                if (tasks.length === 0) {
                    container.innerHTML = '<div class="no-tasks">✅ Nessun task da completare!</div>';
                    return;
                }

                const categories = {};
                tasks.forEach(task => {
                    if (!categories[task.categoria_nome]) {
                        categories[task.categoria_nome] = {
                            colore: task.colore,
                            tasks: []
                        };
                    }
                    categories[task.categoria_nome].tasks.push(task);
                });

                let html = '';
                for (const [catName, catData] of Object.entries(categories)) {
                    html += `
                        <div class="category-section">
                            <div class="category-header">
                                <div class="category-badge" style="background-color: ${catData.colore}"></div>
                                <div class="category-name">${catName}</div>
                            </div>
                            ${catData.tasks.map(task => renderTask(task)).join('')}
                        </div>
                    `;
                }

                container.innerHTML = html;

            } catch (error) {
                console.error('Errore caricamento task:', error);
                document.getElementById('tasksContainer').innerHTML = 
                    '<div class="error">⚠️ Errore caricamento task</div>';
            }
        }

        function renderTask(task) {
            const isCompleted = task.completed;
            const completedBy = task.completions.length > 0 ? task.completions[0].dipendente_nome : '';

            return `
                <div class="task-item ${isCompleted ? 'completed' : ''}" id="task-${task.id}">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" 
                               ${isCompleted ? 'checked disabled' : ''}
                               onchange="completeTask(${task.id}, '${task.nome}', this.checked)">
                    </div>
                    <div class="task-content">
                        <div class="task-name">${task.nome}</div>
                        <div class="task-info">${task.postazione === 'qualsiasi' ? 'Generale' : task.postazione}</div>
                        ${isCompleted ? `<div class="completed-by">Fatto da ${completedBy}</div>` : ''}
                    </div>
                </div>
            `;
        }

        async function completeTask(taskId, taskNome, checked) {
            if (!checked) return;

            if (!currentDipendente) {
                alert('⚠️ Seleziona prima il tuo nome!');
                loadTasks();
                return;
            }

            const conferma = confirm(`Confermi di aver completato:\n"${taskNome}"?\n\nDipendente: ${currentDipendente}`);
            if (!conferma) {
                loadTasks();
                return;
            }

            try {
                const res = await fetch(`${API_BASE}/tasks/complete`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        task_id: taskId,
                        dipendente_nome: currentDipendente,
                        turno_id: currentTurno ? currentTurno.turno_id : null
                    })
                });

                const result = await res.json();
                
                if (result.id) {
                    const taskElement = document.getElementById(`task-${taskId}`);
                    taskElement.classList.add('completed');
                    taskElement.querySelector('.task-content').innerHTML += 
                        `<div class="completed-by">Fatto da ${currentDipendente}</div>`;
                    taskElement.querySelector('input[type="checkbox"]').disabled = true;
                } else {
                    alert('⚠️ Errore nel salvataggio');
                    loadTasks();
                }

            } catch (error) {
                console.error('Errore completamento task:', error);
                alert('⚠️ Errore di connessione');
                loadTasks();
            }
        }

        init();
    </script>
</body>
</html>
