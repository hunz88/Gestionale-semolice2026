<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionale Completo</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        /* Login Screen */
        #loginScreen {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
        }
        .login-box {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }
        .login-box h1 {
            margin-bottom: 30px;
            color: #333;
        }
        .pin-input {
            width: 100%;
            padding: 15px;
            font-size: 24px;
            text-align: center;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            letter-spacing: 10px;
            margin-bottom: 20px;
        }
        .login-btn {
            width: 100%;
            padding: 15px;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
        }
        .login-btn:hover {
            background: #5568d3;
        }
        .error-msg {
            color: #e74c3c;
            margin-top: 15px;
            font-size: 14px;
        }
        #mainContent {
            display: none;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; }
        .container { max-width: 1600px; margin: 0 auto; background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
        .header { background: #2c3e50; color: white; padding: 25px; text-align: center; }
        .header h1 { font-size: 2em; }
        .tabs { display: flex; background: #34495e; }
        .tab { flex: 1; padding: 15px; text-align: center; color: white; cursor: pointer; border: none; background: none; font-size: 1em; font-weight: bold; }
        .tab.active { background: white; color: #2c3e50; }
        .content { display: none; padding: 25px; }
        .content.active { display: block; }
        .form { background: #f5f5f5; padding: 20px; margin-bottom: 20px; border-radius: 8px; }
        .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; color: #333; }
        input, select { width: 100%; padding: 10px; border: 2px solid #ddd; border-radius: 5px; font-size: 14px; }
        input:focus, select:focus { outline: none; border-color: #3498db; }
        .btn { padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 14px; margin-right: 10px; margin-bottom: 10px; }
        .btn-primary { background: #3498db; color: white; }
        .btn-success { background: #27ae60; color: white; }
        .btn-warning { background: #f39c12; color: white; }
        .btn-danger { background: #e74c3c; color: white; }
        .btn-info { background: #17a2b8; color: white; }
        .btn-sm { padding: 6px 12px; font-size: 12px; margin: 0 3px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background: #34495e; color: white; }
        tbody tr:hover { background: #f5f5f5; }
        .week-nav { display: flex; justify-content: space-between; align-items: center; background: #3498db; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        .week-nav button { background: white; color: #3498db; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold; }
        .week-grid { display: grid; grid-template-columns: 150px repeat(7, 1fr); gap: 2px; background: #ddd; border-radius: 8px; overflow: hidden; }
        .week-cell { background: white; padding: 10px; min-height: 80px; }
        .week-header { background: #34495e; color: white; padding: 10px; text-align: center; font-weight: bold; }
        .turno { background: #27ae60; color: white; padding: 8px; border-radius: 4px; margin: 2px 0; font-size: 12px; }
        .turno.daldon { background: #27ae60; }
        .turno.sunset { background: #f39c12; }
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); }
        .modal-content { background: white; margin: 3% auto; padding: 0; border-radius: 10px; width: 90%; max-width: 600px; }
        .modal-header { background: #3498db; color: white; padding: 20px; border-radius: 10px 10px 0 0; }
        .modal-body { padding: 20px; max-height: 70vh; overflow-y: auto; }
        .close { float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
        .alert { padding: 12px; border-radius: 5px; margin: 10px 0; font-weight: bold; }
        .alert-warning { background: #fff3cd; color: #856404; border: 2px solid #ffc107; }
        .alert-info { background: #d1ecf1; color: #0c5460; border: 2px solid #17a2b8; }
        .alert-success { background: #d4edda; color: #155724; border: 2px solid #28a745; }
        .msg { padding: 10px; margin: 10px 0; border-radius: 5px; }
        .msg.ok { background: #d4edda; color: #155724; }
        .msg.err { background: #f8d7da; color: #721c24; }
        .riepilogo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0; }
        .riepilogo-card { background: #f8f9fa; padding: 20px; border-radius: 8px; text-align: center; }
        .riepilogo-label { font-size: 14px; color: #666; margin-bottom: 5px; }
        .riepilogo-value { font-size: 28px; font-weight: bold; color: #2c3e50; }
        .riepilogo-value.money { color: #27ae60; }
        .giorni-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; margin: 15px 0; }
        .giorno-check { display: flex; align-items: center; padding: 10px; background: #f5f5f5; border-radius: 5px; cursor: pointer; }
        .giorno-check input { margin-right: 8px; }
        .giorno-check:hover { background: #e0e0e0; }
        .dip-checkbox { display: flex; align-items: center; padding: 8px; background: #f5f5f5; border-radius: 5px; margin: 5px 0; }
        .dip-checkbox input { margin-right: 8px; }
        .export-header { background: #2c3e50; color: white; padding: 15px; text-align: center; border-radius: 8px 8px 0 0; margin-bottom: 10px; }
        .export-grid { display: table; width: 100%; border-collapse: collapse; }
        .export-row { display: table-row; }
        .export-cell { display: table-cell; border: 1px solid #ddd; padding: 8px; vertical-align: top; min-width: 100px; }
        .export-cell.header { background: #34495e; color: white; font-weight: bold; text-align: center; }
        .export-cell.dip-name { background: #34495e; color: white; font-weight: bold; }
        .export-turno { background: #27ae60; color: white; padding: 5px; border-radius: 3px; margin: 2px 0; font-size: 11px; }
        .export-turno.sunset { background: #f39c12; }
        .contributi-box { background: #fff3cd; padding: 15px; border-radius: 8px; border: 2px solid #ffc107; margin: 20px 0; }
        .storico-item { background: #f8f9fa; padding: 15px; border-radius: 8px; margin: 10px 0; border-left: 4px solid #27ae60; }
    </style>
</head>
<body>
    <!-- Login Screen -->
    <div id="loginScreen">
        <div class="login-box">
            <h1>🔐 Accesso Gestionale</h1>
            <input type="password" 
                   class="pin-input" 
                   id="pinInput" 
                   placeholder="000000" 
                   maxlength="6"
                   inputmode="numeric">
            <button class="login-btn" onclick="checkLogin()">ACCEDI</button>
            <div class="error-msg" id="errorMsg"></div>
        </div>
    </div>

    <!-- Main Content -->
    <div id="mainContent">
    <div class="container">
        <div class="header">
            <h1>🏪 Gestionale Dipendenti Completo</h1>
            <p>Dicembre 2024</p>
        </div>
        
        <div class="tabs">
            <button class="tab active" onclick="showTab('dipendenti')">👥 Dipendenti</button>
            <button class="tab" onclick="showTab('turnistica')">📅 Turnistica</button>
            <button class="tab" onclick="showTab('riepilogo')">💰 Riepilogo</button>
        </div>
        
        <div id="dipendenti" class="content active">
            <div id="message"></div>
            <div class="form">
                <h3>Aggiungi Dipendente</h3>
                <div class="row">
                    <div><label>Nome *</label><input type="text" id="nome" required></div>
                    <div><label>Ruolo *</label><input type="text" id="ruolo" required></div>
                    <div><label>Telefono</label><input type="tel" id="telefono"></div>
                    <div><label>Paga Oraria (€) *</label><input type="number" id="paga" value="10" step="0.5" required></div>
                    <div><label>Ore Contrattuali *</label><input type="number" id="ore" value="8" step="0.5" required><small style="color:#666;">Ore minime giornaliere</small></div>
                </div>
                <button class="btn btn-success" onclick="addDip()">Aggiungi Dipendente</button>
            </div>
            <table><thead><tr><th>Nome</th><th>Ruolo</th><th>Telefono</th><th>Paga/h</th><th>Ore Minime</th><th>Azioni</th></tr></thead><tbody id="listaDip"></tbody></table>
        </div>
        
        <div id="turnistica" class="content">
            <div class="week-nav">
                <button onclick="prevWeek()">◀ Settimana Prec</button>
                <div><h3 id="weekTitle">Settimana</h3></div>
                <button onclick="nextWeek()">Settimana Succ ▶</button>
            </div>
            <button class="btn btn-success" onclick="openAddTurno()">➕ Aggiungi Turno Singolo</button>
            <button class="btn btn-primary" onclick="openAddTurniMultipli()">📅 Aggiungi Turni Multipli</button>
            <button class="btn btn-info" onclick="openExport()">📸 Esporta Calendario JPEG</button>
            <a href="assenze.html" class="btn btn-warning" style="display:inline-block; text-decoration:none;">📋 Registro Assenze</a>
            <div class="form" style="margin-top:20px;"><h3>💶 Soldi Necessari Questa Settimana</h3><div id="weekSummary"></div></div>
            <div class="week-grid" id="weekGrid" style="margin-top:15px;"></div>
        </div>
        
        <div id="riepilogo" class="content">
            <div class="form">
                <h3>Calcola Riepilogo Mensile</h3>
                <div class="row">
                    <div><label>Dipendente</label><select id="riepDip"></select></div>
                    <div><label>Mese</label><select id="riepMese"><option value="1">Gennaio</option><option value="2">Febbraio</option><option value="3">Marzo</option><option value="4">Aprile</option><option value="5">Maggio</option><option value="6">Giugno</option><option value="7">Luglio</option><option value="8">Agosto</option><option value="9">Settembre</option><option value="10">Ottobre</option><option value="11">Novembre</option><option value="12" selected>Dicembre</option></select></div>
                    <div><label>Anno</label><select id="riepAnno"><option value="2024" selected>2024</option><option value="2025">2025</option></select></div>
                </div>
                <button class="btn btn-primary" onclick="calcRiepilogo()">Calcola</button>
                <button class="btn btn-info" onclick="loadStorico()">📊 Vedi Storico</button>
            </div>
            <div id="riepResult" style="display:none;">
                <h3 id="riepNome"></h3>
                <div class="riepilogo-grid">
                    <div class="riepilogo-card"><div class="riepilogo-label">Ore Normali</div><div class="riepilogo-value" id="riepOreNorm">0</div></div>
                    <div class="riepilogo-card"><div class="riepilogo-label">Ore Straordinari</div><div class="riepilogo-value" id="riepOreStr">0</div></div>
                    <div class="riepilogo-card"><div class="riepilogo-label">Numero Turni</div><div class="riepilogo-value" id="riepNumTurni">0</div></div>
                    <div class="riepilogo-card"><div class="riepilogo-label">Compenso Normali</div><div class="riepilogo-value money" id="riepCompNorm">€0</div></div>
                    <div class="riepilogo-card"><div class="riepilogo-label">Compenso Straordinari</div><div class="riepilogo-value money" id="riepCompStr">€0</div></div>
                    <div class="riepilogo-card" style="grid-column: span 2;"><div class="riepilogo-label">💰 TOTALE LORDO</div><div class="riepilogo-value money" id="riepCompTot" style="font-size: 36px;">€0</div></div>
                </div>
                <div class="contributi-box">
                    <h4>📝 Contributi e Calcolo Netto</h4>
                    <div class="row" style="margin-top:15px;">
                        <div><label>Contributi (€)</label><input type="number" id="contributi" step="0.01" value="0" onchange="calcNetto()"><small style="color:#666;">Inserisci importo contributi mensili</small></div>
                        <div><label>Netto da Pagare</label><input type="number" id="nettoPagare" step="0.01" value="0" readonly style="background:#e8f5e9; font-weight:bold; font-size:18px;"></div>
                    </div>
                    <div style="margin-top:15px;">
                        <button class="btn btn-success" onclick="salvaRiepilogo()">💾 Salva Riepilogo Mensile</button>
                        <div id="savedInfo" style="margin-top:10px; display:none; color:#155724; font-weight:bold;"></div>
                    </div>
                </div>
            </div>
            <div id="storicoResult" style="display:none; margin-top:30px;"><h3>📊 Storico Riepilogo Salvati</h3><div id="storicoList"></div></div>
        </div>
    </div>
    <div id="modalEditDip" class="modal"><div class="modal-content"><div class="modal-header"><span class="close" onclick="closeModalDip()">&times;</span><h2>✏️ Modifica Dipendente</h2></div><div class="modal-body"><input type="hidden" id="editDipId"><div><label>Nome *</label><input type="text" id="editNome" required></div><div style="margin-top:10px;"><label>Ruolo *</label><input type="text" id="editRuolo" required></div><div style="margin-top:10px;"><label>Telefono</label><input type="tel" id="editTel"></div><div class="row" style="margin-top:15px;"><div><label>Paga Oraria (€) *</label><input type="number" id="editPaga" step="0.5" required></div><div><label>Ore Contrattuali *</label><input type="number" id="editOre" step="0.5" required></div></div><div style="margin-top:20px;"><button class="btn btn-success" onclick="saveDip()">Salva</button><button class="btn btn-danger" onclick="closeModalDip()">Annulla</button></div></div></div></div>
    
    <div id="modalTurno" class="modal"><div class="modal-content"><div class="modal-header"><span class="close" onclick="closeModalTurno()">&times;</span><h2 id="turnoTitle">➕ Aggiungi Turno</h2></div><div class="modal-body"><input type="hidden" id="turnoId"><div><label>Dipendente *</label><select id="turnoDip" onchange="updateOreInfo()"></select><div id="dipInfo" style="margin-top:10px;padding:10px;background:#e3f2fd;border-radius:5px;display:none;"><small><strong>Ore contrattuali:</strong> <span id="infoOre">-</span>h | <strong>Paga:</strong> €<span id="infoPaga">-</span>/h</small></div></div><div class="row" style="margin-top:15px;"><div><label>Data *</label><input type="date" id="turnoData" required></div><div><label>Bar *</label><select id="turnoBar"><option value="daldon">Bar Dal Don</option><option value="sunset">Sunset Bar</option></select></div></div><div class="row" style="margin-top:15px;"><div><label>Orario Inizio *</label><input type="time" id="turnoInizio" value="18:00" onchange="calcOre()"></div><div><label>Orario Fine *</label><input type="time" id="turnoFine" value="01:00" onchange="calcOre()"></div></div><div id="oreAlert" style="display:none;margin-top:15px;"></div><div class="row" style="margin-top:15px;"><div><label>Ore Normali</label><input type="number" id="turnoOreNorm" step="0.5" value="0" readonly style="background:#f5f5f5;"></div><div><label>Ore Straordinari</label><input type="number" id="turnoOreStr" step="0.5" value="0" readonly style="background:#f5f5f5;"></div></div><div style="margin-top:15px;"><label>Note</label><input type="text" id="turnoNote" placeholder="Malattia, permesso..."></div><div style="margin-top:20px;"><button class="btn btn-success" onclick="saveTurno()">Salva Turno</button><button class="btn btn-danger" onclick="closeModalTurno()">Annulla</button></div></div></div></div>
    
    <div id="modalMulti" class="modal"><div class="modal-content"><div class="modal-header"><span class="close" onclick="closeModalMulti()">&times;</span><h2>📅 Aggiungi Turni Multipli</h2></div><div class="modal-body"><div><label>Dipendente *</label><select id="multiDip" onchange="updateMultiOreInfo()"></select><div id="multiDipInfo" style="margin-top:10px;padding:10px;background:#e3f2fd;border-radius:5px;display:none;"><small><strong>Ore contrattuali:</strong> <span id="multiInfoOre">-</span>h | <strong>Paga:</strong> €<span id="multiInfoPaga">-</span>/h</small></div></div><div class="row" style="margin-top:15px;"><div><label>Data Inizio *</label><input type="date" id="multiDataInizio" required></div><div><label>Data Fine *</label><input type="date" id="multiDataFine" required></div></div><div style="margin-top:15px;"><label>Giorni della Settimana *</label><div class="giorni-grid"><label class="giorno-check"><input type="checkbox" value="lun" id="gLun"><span>Lun</span></label><label class="giorno-check"><input type="checkbox" value="mar" id="gMar"><span>Mar</span></label><label class="giorno-check"><input type="checkbox" value="mer" id="gMer"><span>Mer</span></label><label class="giorno-check"><input type="checkbox" value="gio" id="gGio"><span>Gio</span></label><label class="giorno-check"><input type="checkbox" value="ven" id="gVen"><span>Ven</span></label><label class="giorno-check"><input type="checkbox" value="sab" id="gSab"><span>Sab</span></label><label class="giorno-check"><input type="checkbox" value="dom" id="gDom"><span>Dom</span></label></div></div><div class="row" style="margin-top:15px;"><div><label>Bar *</label><select id="multiBar"><option value="daldon">Bar Dal Don</option><option value="sunset">Sunset Bar</option></select></div></div><div class="row" style="margin-top:15px;"><div><label>Orario Inizio *</label><input type="time" id="multiInizio" value="07:00" onchange="calcMultiOre()"></div><div><label>Orario Fine *</label><input type="time" id="multiFine" value="12:00" onchange="calcMultiOre()"></div></div><div id="multiAlert" style="display:none;margin-top:15px;"></div><div class="row" style="margin-top:15px;"><div><label>Ore Normali</label><input type="number" id="multiOreNorm" step="0.5" value="0" readonly style="background:#f5f5f5;"></div><div><label>Ore Straordinari</label><input type="number" id="multiOreStr" step="0.5" value="0" readonly style="background:#f5f5f5;"></div></div><div style="margin-top:15px;"><label>Note (opzionali)</label><input type="text" id="multiNote" placeholder="es: Turno fisso mattina"></div><div style="margin-top:20px;"><button class="btn btn-success" onclick="saveMulti()">✅ Crea Tutti i Turni</button><button class="btn btn-danger" onclick="closeModalMulti()">Annulla</button></div></div></div></div>
    
    <div id="modalExport" class="modal"><div class="modal-content"><div class="modal-header"><span class="close" onclick="closeModalExport()">&times;</span><h2>📸 Esporta Calendario JPEG</h2></div><div class="modal-body"><div class="row"><div><label>Data Inizio *</label><input type="date" id="exportInizio" required></div><div><label>Data Fine *</label><input type="date" id="exportFine" required></div></div><div style="margin-top:15px;"><label>Dipendenti da Includere</label><div style="margin-top:10px;max-height:200px;overflow-y:auto;"><label class="dip-checkbox"><input type="checkbox" id="exportAll" onchange="toggleAllDip()" checked><strong>Tutti i dipendenti</strong></label><div id="exportDipList"></div></div></div><div style="margin-top:20px;"><button class="btn btn-success" onclick="generateExport()">🎨 Genera Anteprima</button><button class="btn btn-danger" onclick="closeModalExport()">Annulla</button></div><div id="exportPreviewContainer" style="display:none; margin-top:20px;"><div id="exportPreview"></div><div style="text-align:center; margin-top:15px;"><button class="btn btn-success" onclick="downloadExport()">📥 Scarica JPEG</button></div></div></div></div></div>

    <script>
        let dip = [];
        let turni = [];
        let currentWeek = getMonday(new Date());
        let currentRiepDip = null;
        let currentRiepAnno = null;
        let currentRiepMese = null;

        function getMonday(d) {
            d = new Date(d);
            const day = d.getDay();
            const diff = d.getDate() - day + (day === 0 ? -6 : 1);
            return new Date(d.setDate(diff));
        }

        function formatDate(d) {
            return d.toISOString().split('T')[0];
        }

        function msg(text, type='ok') {
            const m = document.getElementById('message');
            m.innerHTML = '<div class="msg '+type+'">'+text+'</div>';
            setTimeout(() => m.innerHTML = '', 3000);
        }

        function showTab(tab) {
            document.querySelectorAll('.content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(tab).classList.add('active');
            event.target.classList.add('active');
            if(tab === 'turnistica') loadWeek();
            if(tab === 'riepilogo') updateRiepSelects();
        }

        async function loadDip() {
            const res = await fetch('/api/dipendenti');
            dip = await res.json();
            const html = dip.map(d => `<tr><td><b>${d.nome}</b></td><td>${d.ruolo}</td><td>${d.telefono||'-'}</td><td style="color:#27ae60;font-weight:bold;">€${d.paga_oraria}</td><td style="font-weight:bold;">${d.ore_contrattuali}h</td><td><button class="btn btn-warning btn-sm" onclick="editDip(${d.id})">✏️</button><button class="btn btn-danger btn-sm" onclick="delDip(${d.id})">🗑️</button></td></tr>`).join('');
            document.getElementById('listaDip').innerHTML = html || '<tr><td colspan="6">Nessun dipendente</td></tr>';
            updateDipSelects();
        }

        async function addDip() {
            const data = {nome: document.getElementById('nome').value, ruolo: document.getElementById('ruolo').value, telefono: document.getElementById('telefono').value, paga_oraria: document.getElementById('paga').value, ore_contrattuali: document.getElementById('ore').value};
            const res = await fetch('/api/dipendenti', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)});
            if(res.ok) { msg('✅ Dipendente aggiunto!'); document.getElementById('nome').value = ''; document.getElementById('ruolo').value = ''; document.getElementById('telefono').value = ''; loadDip(); } else { msg('Errore!', 'err'); }
        }

        function editDip(id) {
            const d = dip.find(x => x.id === id);
            document.getElementById('editDipId').value = d.id;
            document.getElementById('editNome').value = d.nome;
            document.getElementById('editRuolo').value = d.ruolo;
            document.getElementById('editTel').value = d.telefono || '';
            document.getElementById('editPaga').value = d.paga_oraria;
