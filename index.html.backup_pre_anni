        async function calcRiepilogo() {
            const dipId = document.getElementById('riepDip').value;
            const mese = document.getElementById('riepMese').value;
            const anno = document.getElementById('riepAnno').value;
            if(!dipId) { alert('Seleziona un dipendente'); return; }
            currentRiepDip = dipId;
            currentRiepAnno = anno;
            currentRiepMese = mese;
            const res = await fetch(`/api/riepilogo/${dipId}/${anno}/${mese}`);
            const data = await res.json();
            document.getElementById('riepNome').textContent = `Riepilogo ${data.nome || '-'} - ${mese}/${anno}`;
            document.getElementById('riepOreNorm').textContent = (data.tot_normali || 0).toFixed(1) + 'h';
            document.getElementById('riepOreStr').textContent = (data.tot_straordinari || 0).toFixed(1) + 'h';
            document.getElementById('riepNumTurni').textContent = data.num_turni || 0;
            document.getElementById('riepCompNorm').textContent = '€' + (data.comp_normali || 0).toFixed(2);
            document.getElementById('riepCompStr').textContent = '€' + (data.comp_straordinari || 0).toFixed(2);
            document.getElementById('riepCompTot').textContent = '€' + (data.comp_totale || 0).toFixed(2);
            if(data.saved) { document.getElementById('contributi').value = data.saved.contributi || 0; document.getElementById('savedInfo').style.display = 'block'; document.getElementById('savedInfo').textContent = '✅ Riepilogo salvato il ' + new Date(data.saved.salvato_il).toLocaleDateString('it-IT'); } else { document.getElementById('contributi').value = 0; document.getElementById('savedInfo').style.display = 'none'; }
            calcNetto();
            document.getElementById('riepResult').style.display = 'block';
        }

        function calcNetto() {
            const lordo = parseFloat(document.getElementById('riepCompTot').textContent.replace('€', '')) || 0;
            const contributi = parseFloat(document.getElementById('contributi').value) || 0;
            const netto = lordo - contributi;
            document.getElementById('nettoPagare').value = netto.toFixed(2);
        }

        async function salvaRiepilogo() {
            if(!currentRiepDip || !currentRiepAnno || !currentRiepMese) { alert('Calcola prima il riepilogo!'); return; }
