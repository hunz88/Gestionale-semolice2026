        function calcOre() {
            const sel = document.getElementById('turnoDip');
            const d = dip.find(x => x.id == sel.value);
            if(!d) return;
            const inizio = document.getElementById('turnoInizio').value;
            const fine = document.getElementById('turnoFine').value;
            if(!inizio || !fine) return;
            const [hi, mi] = inizio.split(':').map(Number);
            const [hf, mf] = fine.split(':').map(Number);
            let ore = hf - hi;
            let min = mf - mi;
            if(ore < 0) ore += 24;
            if(min < 0) { ore--; min += 60; }
            const totOre = ore + (min / 60);
            const oreContr = parseFloat(d.ore_contrattuali);
            let normali, straord;
            if(totOre <= oreContr) { normali = totOre; straord = 0; } else { normali = oreContr; straord = totOre - oreContr; }
            document.getElementById('turnoOreNorm').value = normali.toFixed(1);
            document.getElementById('turnoOreStr').value = straord.toFixed(1);
            const alert = document.getElementById('oreAlert');
            if(totOre < oreContr) { const mancanti = oreContr - totOre; alert.className = 'alert alert-warning'; alert.innerHTML = `⚠️ <strong>Attenzione!</strong> Turno di ${totOre.toFixed(1)}h, mancano ${mancanti.toFixed(1)}h rispetto al contratto (${oreContr}h)`; alert.style.display = 'block'; } else if(straord > 0) { alert.className = 'alert alert-info'; alert.innerHTML = `ℹ️ <strong>Info:</strong> ${normali.toFixed(1)}h normali + ${straord.toFixed(1)}h straordinari = ${totOre.toFixed(1)}h totali`; alert.style.display = 'block'; } else { alert.style.display = 'none'; }
        }

