            const res = await fetch('/api/riepilogo/salva', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)});
            if(res.ok) { msg('✅ Riepilogo salvato!'); document.getElementById('savedInfo').style.display = 'block'; document.getElementById('savedInfo').textContent = '✅ Riepilogo salvato ora'; } else { msg('Errore salvataggio!', 'err'); }
        }

