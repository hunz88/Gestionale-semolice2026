        function updateOreInfo() {
            const sel = document.getElementById('turnoDip');
            const d = dip.find(x => x.id == sel.value);
            if(d) { document.getElementById('infoOre').textContent = d.ore_contrattuali; document.getElementById('infoPaga').textContent = d.paga_oraria; document.getElementById('dipInfo').style.display = 'block'; } else { document.getElementById('dipInfo').style.display = 'none'; }
