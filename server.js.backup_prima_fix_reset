        FROM turni t 
        JOIN dipendenti d ON t.dipendente_id = d.id 
        WHERE d.attivo = 1 
        AND t.data >= date(?)
        AND t.data <= date(?)
        ${dipendenti_ids && dipendenti_ids.length > 0 ? 'AND d.id IN (' + dipendenti_ids.join(',') + ')' : ''}
